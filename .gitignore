# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.ipynb_checkpoints/

# Datasets are downloaded, not committed (see data/README.md).
# The folder skeleton and its placeholder notes ARE committed, so the
# expected layout is visible in a fresh clone.
data/**
!data/*/
!data/README.md
!data/*/PUT_*_HERE.md

# Trained checkpoints (~4 GB) and run logs
results/**/models/
logs/

# Ukrainian report variants (generated only with --lang en,ua)
reports/**/*_UA.docx

# Generated by the PJM notebooks, part of the (not shipped) cross-study comparison
results/**/cross_region_comparison.csv
